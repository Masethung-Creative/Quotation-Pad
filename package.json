{
  "name": "quotation-pad",
  "private": true,
  "version": "0.1.0",
  "description": "Any quotation, on your letterpad. 100% in-browser, zero-cost.",
  "license": "MIT",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "node scripts/copy-assets.mjs && tsc -b && vite build && node scripts/check-dist.mjs",
    "preview": "vite preview --port 4391 --strictPort",
    "typecheck": "tsc -b",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "test:golden:update": "playwright test golden --update-snapshots",
    "assets": "node scripts/copy-assets.mjs",
    "fonts": "node scripts/fetch-fonts.mjs",
    "samples": "node scripts/make-samples.mjs",
    "postinstall": "node scripts/copy-assets.mjs",
    "licenses": "node scripts/check-licenses.mjs",
    "templates:check": "vitest run tests/unit/templates.test.ts",
    "templates:placeholders": "node scripts/make-placeholder-templates.mjs",
    "lighthouse": "node scripts/lighthouse.mjs"
  },
  "dependencies": {
    "@hookform/resolvers": "^7.0.7",
    "@radix-ui/react-dialog": "^1.3.1",
    "@radix-ui/react-dropdown-menu": "^2.2.1",
    "@radix-ui/react-label": "^2.1.17",
    "@radix-ui/react-slot": "^1.5.0",
    "@radix-ui/react-switch": "^1.4.1",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "dexie": "^4.4.7",
    "dexie-react-hooks": "^4.4.0",
    "heic2any": "^0.0.4",
    "lucide-react": "^1.74.0",
    "mammoth": "^1.13.0",
    "pdf-lib": "^1.17.1",
    "pdfjs-dist": "^6.5.438",
    "pdfmake": "^0.3.14",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-hook-form": "^7.92.0",
    "signature_pad": "^5.1.4",
    "sonner": "^2.0.8",
    "tailwind-merge": "^3.7.0",
    "tesseract.js": "^7.0.0",
    "wasm-feature-detect": "^1.10.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@napi-rs/canvas": "^1.1.1",
    "@playwright/test": "^1.65.1",
    "@tailwindcss/vite": "^4.3.5",
    "@tesseract.js-data/eng": "^1.0.0",
    "@tesseract.js-data/hin": "^1.0.0",
    "@tesseract.js-data/tam": "^1.0.0",
    "@types/jsdom": "^30.0.0",
    "@types/node": "^26.6.6",
    "@types/pdfmake": "^0.3.3",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.3.0",
    "docx": "^9.15.4",
    "fake-indexeddb": "^6.2.8",
    "jsdom": "^31.0.1",
    "lighthouse": "^13.6.0",
    "tailwindcss": "^4.3.5",
    "typescript": "^7.0.2",
    "vite": "^8.3.8",
    "vite-plugin-pwa": "^2.0.0",
    "vitest": "^5.1.0"
  }
}
