# Cloudflare Pages headers. `vite preview` serves the "/*" block too, so tests run under this CSP.
#
# connect-src 'self' is the browser-enforced version of "nothing leaves the device": the
# page cannot send data to any other server. 'wasm-unsafe-eval' runs the OCR engine
# (WebAssembly). 'unsafe-eval' is needed by heic2any (converts iPhone HEIC photos on
# Android/Chrome), whose Emscripten runtime builds functions at start-up.
/*
  Content-Security-Policy: default-src 'self'; script-src 'self' 'sha256-XJSvuYTlKHfmfHdEpwvphY/bqV69VD4kibRKXH+kOmk=' 'wasm-unsafe-eval' 'unsafe-eval'; worker-src 'self' blob:; connect-src 'self' blob: data:; img-src 'self' blob: data:; style-src 'self' 'unsafe-inline'; font-src 'self' data:; manifest-src 'self'; object-src 'none'; base-uri 'self'; form-action 'self'; frame-ancestors 'none'
  Referrer-Policy: no-referrer
  X-Content-Type-Options: nosniff
  X-Frame-Options: DENY
  Permissions-Policy: camera=(self), microphone=(), geolocation=(), payment=(), usb=(), browsing-topics=()
  Cross-Origin-Opener-Policy: same-origin

/assets/*
  Cache-Control: public, max-age=31536000, immutable

/tesseract/*
  Cache-Control: public, max-age=31536000, immutable

/sw.js
  Cache-Control: no-cache

/session.json
  Cache-Control: no-store
